+++ b/tests/test_vt_rgb_decoder.cpp
@@ -0,0 +1,244 @@
+/*
+ * This file is part of the OpenKinect Project. http://www.openkinect.org
+ *
+ * This code is licensed under either the Apache License, Version 2.0, or the
+ * GNU General Public License, Version 2.0. See APACHE20 and GPL2.
+ */
+
+#include <gtest/gtest.h>
+
+#include <libfreenect2/config.h>
+
+#if defined(LIBFREENECT2_WITH_VT_SUPPORT) && defined(LIBFREENECT2_WITH_TURBOJPEG_SUPPORT)
+
+#include <libfreenect2/rgb_decoder_fallback.h>
+#include <libfreenect2/rgb_packet_processor.h>
+#include <turbojpeg.h>
+
+#include <cmath>
+#include <cstdlib>
+#include <memory>
+#include <thread>
+#include <vector>
+
+namespace libfreenect2
+{
+namespace
+{
+
+const int kWidth = 1920;
+const int kHeight = 1080;
+
+/** A Kinect-like colour JPEG: 1920x1080, 4:2:2, quality 90, with padding
+ *  after the EOI marker as in the USB packets. */
+std::vector<unsigned char> makeJpeg(int seed)
+{
+  std::vector<unsigned char> rgb(kWidth * kHeight * 3);
+  for (int y = 0; y < kHeight; ++y)
+    for (int x = 0; x < kWidth; ++x)
+      for (int c = 0; c < 3; ++c)
+      {
+        const double v = 128 + 90 * std::sin((x + seed * 17) * 0.004 * (c + 1)) * std::cos(y * 0.003 * (c + 2));
+        rgb[(y * kWidth + x) * 3 + c] = static_cast<unsigned char>(v);
+      }
+  tjhandle compressor = tjInitCompress();
+  unsigned char* out = 0;
+  unsigned long out_size = 0;
+  EXPECT_EQ(0, tjCompress2(compressor, &rgb[0], kWidth, 0, kHeight, TJPF_RGB, &out, &out_size, TJSAMP_422, 90, 0));
+  std::vector<unsigned char> jpeg(out, out + out_size);
+  tjFree(out);
+  tjDestroy(compressor);
+  jpeg.insert(jpeg.end(), 3, 0);
+  return jpeg;
+}
+
+std::vector<unsigned char> decodeTurbo(const std::vector<unsigned char>& jpeg)
+{
+  std::vector<unsigned char> bgrx(kWidth * kHeight * 4);
+  tjhandle decompressor = tjInitDecompress();
+  EXPECT_EQ(0, tjDecompress2(decompressor, &jpeg[0], jpeg.size(), &bgrx[0], kWidth, kWidth * 4, kHeight, TJPF_BGRX, 0));
+  tjDestroy(decompressor);
+  return bgrx;
+}
+
+RgbPacket makePacket(std::vector<unsigned char>& jpeg, uint32_t sequence)
+{
+  RgbPacket packet;
+  packet.sequence = sequence;
+  packet.timestamp = sequence * 266;
+  packet.arrival_timestamp_us = sequence * 33333;
+  packet.jpeg_buffer = jpeg.empty() ? 0 : &jpeg[0];
+  packet.jpeg_buffer_length = jpeg.size();
+  packet.exposure = 1.f;
+  packet.gain = 2.f;
+  packet.gamma = 3.f;
+  packet.memory = 0;
+  return packet;
+}
+
+class CollectingListener : public FrameListener
+{
+public:
+  ~CollectingListener()
+  {
+    for (size_t i = 0; i < frames.size(); ++i)
+      delete frames[i];
+  }
+  virtual bool onNewFrame(Frame::Type type, Frame* frame)
+  {
+    EXPECT_EQ(Frame::Color, type);
+    frames.push_back(frame);
+    return true;
+  }
+  std::vector<Frame*> frames;
+};
+
+double meanAbsDiff(const unsigned char* a, const unsigned char* b)
+{
+  double sum = 0;
+  for (size_t i = 0; i < static_cast<size_t>(kWidth) * kHeight * 4; ++i)
+    if (i % 4 != 3)
+      sum += std::abs(static_cast<int>(a[i]) - static_cast<int>(b[i]));
+  return sum / (static_cast<double>(kWidth) * kHeight * 3);
+}
+
+TEST(VTRgbDecoder, DecodesLikeTurboJpeg)
+{
+  VTRgbPacketProcessor vt;
+  ASSERT_TRUE(vt.good());
+  CollectingListener listener;
+  vt.setFrameListener(&listener);
+
+  std::vector<unsigned char> jpeg = makeJpeg(0);
+  vt.process(makePacket(jpeg, 7));
+
+  ASSERT_EQ(1u, listener.frames.size());
+  Frame* frame = listener.frames[0];
+  ASSERT_TRUE(frame->data != 0);
+  EXPECT_EQ(static_cast<size_t>(kWidth), frame->width);
+  EXPECT_EQ(static_cast<size_t>(kHeight), frame->height);
+  EXPECT_EQ(4u, frame->bytes_per_pixel);
+  EXPECT_EQ(Frame::BGRX, frame->format);
+  EXPECT_EQ(7u, frame->sequence);
+  EXPECT_EQ(7u * 266, frame->timestamp);
+  EXPECT_EQ(7u * 33333, frame->arrival_timestamp_us);
+  EXPECT_FLOAT_EQ(1.f, frame->exposure);
+  EXPECT_FLOAT_EQ(2.f, frame->gain);
+  EXPECT_FLOAT_EQ(3.f, frame->gamma);
+
+  std::vector<unsigned char> reference = decodeTurbo(jpeg);
+  EXPECT_LT(meanAbsDiff(frame->data, &reference[0]), 2.0);
+}
+
+TEST(VTRgbDecoder, FramesOutliveLaterDecodes)
+{
+  VTRgbPacketProcessor vt;
+  CollectingListener listener;
+  vt.setFrameListener(&listener);
+  std::vector<unsigned char> a = makeJpeg(0), b = makeJpeg(50);
+  vt.process(makePacket(a, 1));
+  vt.process(makePacket(b, 2));
+  ASSERT_EQ(2u, listener.frames.size());
+  std::vector<unsigned char> ref_a = decodeTurbo(a), ref_b = decodeTurbo(b);
+  EXPECT_LT(meanAbsDiff(listener.frames[0]->data, &ref_a[0]), 2.0);
+  EXPECT_LT(meanAbsDiff(listener.frames[1]->data, &ref_b[0]), 2.0);
+}
+
+TEST(VTRgbDecoder, DropsCorruptPacketsWithoutCrashing)
+{
+  VTRgbPacketProcessor vt;
+  CollectingListener listener;
+  vt.setFrameListener(&listener);
+
+  std::vector<unsigned char> good = makeJpeg(0);
+  std::vector<unsigned char> truncated(good.begin(), good.begin() + good.size() / 3);
+  std::vector<unsigned char> garbage(4096, 0x5a);
+  std::vector<unsigned char> empty;
+
+  vt.process(makePacket(truncated, 1));
+  vt.process(makePacket(garbage, 2));
+  vt.process(makePacket(empty, 3));
+  EXPECT_TRUE(listener.frames.empty());
+  EXPECT_TRUE(vt.good());
+
+  // A good packet after bad ones decodes normally.
+  vt.process(makePacket(good, 4));
+  ASSERT_EQ(1u, listener.frames.size());
+  ASSERT_TRUE(listener.frames[0]->data != 0);
+  EXPECT_EQ(4u, listener.frames[0]->sequence);
+  EXPECT_TRUE(vt.good());
+}
+
+TEST(VTRgbDecoder, ReportsUnhealthyAfterARunOfFailures)
+{
+  VTRgbPacketProcessor vt;
+  CollectingListener listener;
+  vt.setFrameListener(&listener);
+  std::vector<unsigned char> garbage(4096, 0x5a);
+  for (uint32_t i = 0; i < 40 && vt.good(); ++i)
+    vt.process(makePacket(garbage, i));
+  EXPECT_FALSE(vt.good());
+  EXPECT_TRUE(listener.frames.empty());
+}
+
+TEST(VTRgbDecoder, FallbackTakesOverFromAFailingDecoder)
+{
+  RgbDecoderFallback fallback(new VTRgbPacketProcessor(), new TurboJpegRgbPacketProcessor());
+  CollectingListener listener;
+  fallback.setFrameListener(&listener);
+  EXPECT_STREQ("VideoToolbox", fallback.name());
+
+  std::vector<unsigned char> good = makeJpeg(0);
+  fallback.process(makePacket(good, 0));
+  ASSERT_EQ(1u, listener.frames.size());
+
+  std::vector<unsigned char> garbage(4096, 0x5a);
+  for (uint32_t i = 1; i <= 40; ++i)
+    fallback.process(makePacket(garbage, i));
+  EXPECT_STREQ("TurboJPEG", fallback.name());
+
+  fallback.process(makePacket(good, 41));
+  ASSERT_EQ(2u, listener.frames.size());
+  EXPECT_EQ(41u, listener.frames[1]->sequence);
+}
+
+TEST(VTRgbDecoder, SeveralDecodersInParallel)
+{
+  // One decoder per Kinect, each on its own thread.
+  std::vector<unsigned char> jpeg = makeJpeg(0);
+  const std::vector<unsigned char> reference = decodeTurbo(jpeg);
+  std::vector<std::thread> threads;
+  std::vector<int> decoded(4, 0);
+  std::vector<double> diff(4, 0.0);
+  for (int t = 0; t < 4; ++t)
+    threads.push_back(std::thread([&, t] {
+      VTRgbPacketProcessor vt;
+      CollectingListener listener;
+      vt.setFrameListener(&listener);
+      std::vector<unsigned char> mine = jpeg;
+      for (uint32_t i = 0; i < 30; ++i)
+      {
+        vt.process(makePacket(mine, i));
+        if (listener.frames.size() > 2)
+        {
+          diff[t] = std::max(diff[t], meanAbsDiff(listener.frames.back()->data, &reference[0]));
+          delete listener.frames.front();
+          listener.frames.erase(listener.frames.begin());
+          ++decoded[t];
+        }
+      }
+      decoded[t] += static_cast<int>(listener.frames.size());
+    }));
+  for (size_t t = 0; t < threads.size(); ++t)
+    threads[t].join();
+  for (int t = 0; t < 4; ++t)
+  {
+    EXPECT_EQ(30, decoded[t]);
+    EXPECT_LT(diff[t], 2.0);
+  }
+}
+
+} // namespace
+} // namespace libfreenect2
+
+#endif
