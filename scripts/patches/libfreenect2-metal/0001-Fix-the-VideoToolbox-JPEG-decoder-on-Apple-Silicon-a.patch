+/** Filled by the output callback for one synchronous decode. */
+struct DecodeResult
+{
+  OSStatus status;
+  CVPixelBufferRef pixel_buffer;
+};
+
+void decodeCallback(void *, void *source_frame_ref, OSStatus status, VTDecodeInfoFlags,
+                    CVImageBufferRef image_buffer, CMTime, CMTime)
+{
+  DecodeResult *result = static_cast<DecodeResult *>(source_frame_ref);
+  result->status = status;
+  if (status == noErr && image_buffer != NULL)
+    result->pixel_buffer = CVPixelBufferRetain(image_buffer);
